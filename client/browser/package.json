{
  "name": "openai-deploy-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint:prepare": "rm -rf .lint-generated && tsc lint/module.ui.lint.ts lint/module.route.lint.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --esModuleInterop --outDir .lint-generated --declaration false --noEmit false",
    "lint": "pnpm lint:prepare && oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ${VITE_OPENAPI_URL:-http://127.0.0.1:8000/openapi.json} -o src/platform/api/openapi-schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@shadcn/react": "^0.3.0",
    "@tanstack/ai-client": "^0.23.2",
    "@tanstack/ai-react": "^0.19.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.130.2",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@storybook/react-vite": "^10.5.8",
    "@tanstack/router-plugin": "^1.130.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "openapi-typescript": "^7.9.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.6",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "packageManager": "pnpm@10.14.0"
}
